---
import { Icon } from "astro-icon/components";

export interface Props {
    data: any[];
    title?: string;
}

const { data, title } = Astro.props;

function formatRepoName(name: string) {
    return name
        .replace(/[-_]/g, " ")
        .replace(/([a-z])([A-Z])/g, "$1 $2")
        .toLowerCase()
        .replace(/\b\w/g, (char) => char.toUpperCase());
}

function formatDate(dateStr: string) {
    const date = new Date(dateStr);
    return date.toLocaleDateString("es-ES", {
        day: "2-digit",
        month: "long",
        year: "numeric",
    });
}
import Video from "@/components/Video.astro";
---

<div class="mr-2 md:mr-12 max-w-72 md:max-w-none self-end">
    {title && (
        <h3 class="text-3xl md:text-5xl font-bold text-start pb-12">{title}</h3>
    )}

    <ul class="flex flex-col gap-8 pb-20">
        {data.map((repo, index) => (
            <a
                class="flex gap-2 items-baseline justify-end group"
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
            >
                <li class="flex flex-col gap-4 group self-end">
                    <h2 class="relative inline-block text-2xl font-semibold md:text-4xl">
                        <span class="bg-linear-to-r from-current to-current bg-size-[0%_2px] bg-bottom-left bg-no-repeat transition-all duration-500 group-hover:bg-size-[100%_2px]">
                            {formatRepoName(repo.name)}
                        </span>
                    </h2>
                    {repo.video && repo.mp4 && (
                        <Video
                            webmSrc={repo.video}
                            mp4Src={repo.mp4}
                            className="md:max-w-72 h-auto md:h-32 object-cover object-top group-hover:h-56 border-2 duration-400 transition-all ease-in-out border-black self-end aspect-video"
                        />
                    )}
                    <div class="flex items-center gap-2 md:gap-6 justify-end text-xs md:text-base">
                        <p class="relative inline-block">
                            <span class="bg-linear-to-r from-current to-current bg-size-[0%_1px] bg-bottom-left bg-no-repeat transition-all duration-500 group-hover:bg-size-[100%_1px]">
                                {formatDate(repo.date)}
                            </span>
                        </p>
                        <p class="relative inline-block">
                            <span class="bg-linear-to-r from-current to-current bg-size-[0%_1px] bg-bottom-left bg-no-repeat transition-all duration-500 group-hover:bg-size-[100%_1px]">
                                {repo.language}
                            </span>
                        </p>
                    </div>
                </li>
                <Icon
                    name="external"
                    class="md:w-14 md:h-14 w-10 h-10 shrink-0"
                />
            </a>
        ))}
    </ul>
</div>
