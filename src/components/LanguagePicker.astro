---
// LanguageDropdown.astro
import { languages } from "@/i18n/ui";
import { useTranslatedPath } from "@/i18n/utils";

interface Props {
  currentLang: "en" | "es" | "ca";
  currentPath: string;
}

const { currentLang, currentPath } = Astro.props;
const translatePath = useTranslatedPath(currentLang);
---

<details class="relative group">
  <summary
    class="list-none [&::-webkit-details-marker]:hidden w-12 h-12 flex items-center justify-center border-2 p-2 bg-white dark:bg-black shadow-secondary hover:shadow-secondaryHover dark:border-white cursor-pointer"
  >
    <svg
      class="w-full h-full"
      xmlns="http://www.w3.org/2000/svg"
      width="1em"
      height="1em"
      viewBox="0 0 24 24"
    >
      <path
        fill="currentColor"
        d="m12.87 15.07l-2.54-2.51l.03-.03A17.5 17.5 0 0 0 14.07 6H17V4h-7V2H8v2H1v2h11.17C11.5 7.92 10.44 9.75 9 11.35C8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5l3.11 3.11zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2zm-2.62 7l1.62-4.33L19.12 17z"
      />
    </svg>
  </summary>

  <div class="z-10 mb-2 absolute -top-34 -left-24 shadow-sm w-36 bg-white dark:bg-black dark:border-white border-2">
    <ul class="py-2 text-sm">
      {Object.entries(languages).map(([lang, label]) => (
        <li>
          <a
            href={translatePath(currentPath, lang)}
            class="block px-4 py-2 hover:dark:bg-white/10 hover:bg-black/10"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</details>